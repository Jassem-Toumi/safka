# Copy to .env.local. Never commit .env.local.

# You.com search mode: "fixture" (offline, default) or "live".
YDC_MODE=fixture

# Optional. Sponsor key -> authenticated endpoint https://api.you.com/mcp?tools=you-search
# Without it, live mode uses the keyless endpoint https://api.you.com/mcp/free
YDC_API_KEY=

# Optional. You.com Inference Router model for AI brief suggestions (needs YDC_API_KEY).
# Leave empty to use deterministic RULES mode.
YDC_BRIEF_MODEL=

# Loopback origin. Do not change to a LAN or public address.
APP_ORIGIN=http://127.0.0.1:3000

# SQLite file location (relative to repo root).
DATABASE_PATH=.local/safka.db
